ame":"Referer","value":"http://127.0.0.1:8792/ui/"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/148.0.7778.96 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"HeadlessChrome\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[{"name":"v","value":"20260603a"}],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"accept-ranges","value":"bytes"},{"name":"content-length","value":"38591"},{"name":"content-type","value":"text/css; charset=utf-8"},{"name":"date","value":"Thu, 04 Jun 2026 15:02:05 GMT"},{"name":"etag","value":"\"c9041115d286dec8d7c05b4df303d7c0\""},{"name":"last-modified","value":"Wed, 03 Jun 2026 20:23:24 GMT"},{"name":"server","value":"uvicorn"}],"content":{"size":-1,"mimeType":"text/css; charset=utf-8","text":"/* STOM AI Dashboard — quant terminal tokens */\r\n:root, [data-theme=\"dark\"] {\r\n  --bg-0: #07090c;          /* deep terminal black */\r\n  --bg-1: #0c1014;          /* panel base */\r\n  --bg-2: #11161c;          /* raised */\r\n  --bg-3: #161c24;          /* hover */\r\n  --line-1: #1d2530;        /* hairline */\r\n  --line-2: #2a3441;        /* stronger border */\r\n\r\n  --ink-0: #e8edf2;         /* primary text */\r\n  --ink-1: #a8b3c0;         /* secondary */\r\n  --ink-2: #6a7686;         /* tertiary */\r\n  --ink-3: #45505e;         /* faint */\r\n\r\n  --teal:    #4cd6b3;       /* gains / success */\r\n  --teal-dim:#1f6e5d;\r\n  --green:   #6ee7a8;\r\n  --amber:   #f0b35a;       /* running */\r\n  --amber-dim:#7a5520;\r\n  --red:     #ff6b6b;       /* loss / risk */\r\n  --red-dim: #6b2424;\r\n  --violet:  #a594ff;       /* winner accent */\r\n  --blue:    #6aa6ff;       /* gate-passed accent */\r\n\r\n  --bg-radial-a: rgba(76,214,179,0.04);\r\n  --bg-radial-b: rgba(165,148,255,0.035);\r\n\r\n  --sans: \"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif;\r\n  --mono: \"IBM Plex Mono\", ui-monospace, \"JetBrains Mono\", monospace;\r\n}\r\n\r\n[data-theme=\"light\"] {\r\n  --bg-0: #f5f6f8;\r\n  --bg-1: #ffffff;\r\n  --bg-2: #f0f2f6;\r\n  --bg-3: #e6eaf0;\r\n  --line-1: #e1e5ec;\r\n  --line-2: #c8d0db;\r\n\r\n  --ink-0: #0e131a;\r\n  --ink-1: #3c4655;\r\n  --ink-2: #6a7686;\r\n  --ink-3: #a4adba;\r\n\r\n  --teal:    #0d9b78;\r\n  --teal-dim:#a9e7d4;\r\n  --green:   #128a55;\r\n  --amber:   #b27200;\r\n  --amber-dim:#f0d399;\r\n  --red:     #d63d3d;\r\n  --red-dim: #f3c0c0;\r\n  --violet:  #6a55d6;\r\n  --blue:    #2c6ed4;\r\n\r\n  --bg-radial-a: rgba(13,155,120,0.05);\r\n  --bg-radial-b: rgba(106,85,214,0.045);\r\n}\r\n\r\n* { box-sizing: border-box; }\r\nhtml, body, #root { height: 100%; }\r\nbody {\r\n  margin: 0;\r\n  background: var(--bg-0);\r\n  color: var(--ink-0);\r\n  font-family: var(--sans);\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  letter-spacing: 0.005em;\r\n  -webkit-font-smoothing: antialiased;\r\n  text-rendering: geometricPrecision;\r\n  background-image:\r\n    radial-gradient(1200px 600px at 80% -10%, var(--bg-radial-a), transparent 60%),\r\n    radial-gradient(900px 500px at -10% 110%, var(--bg-radial-b), transparent 60%);\r\n  transition: background-color .25s ease, color .25s ease;\r\n}\r\n\r\n/* Smooth theme transitions on common surfaces */\r\n.panel, .badge, .btn, .input, .select, .toggle, table.gens thead th, table.gens tbody td {\r\n  transition: background-color .2s ease, color .2s ease, border-color .2s ease;\r\n}\r\n\r\n/* Typography */\r\n.mono { font-family: var(--mono); font-feature-settings: \"tnum\" 1, \"zero\" 1; }\r\n.tnum { font-variant-numeric: tabular-nums; }\r\nh1,h2,h3,h4 { margin: 0; font-weight: 500; letter-spacing: -0.01em; }\r\n\r\n/* Reset */\r\nbutton { font: inherit; color: inherit; background: none; border: none; cursor: pointer; padding: 0; }\r\ninput, select, textarea { font: inherit; color: inherit; }\r\n::-webkit-scrollbar { width: 10px; height: 10px; }\r\n::-webkit-scrollbar-track { background: transparent; }\r\n::-webkit-scrollbar-thumb { background: var(--line-1); border-radius: 6px; border: 2px solid var(--bg-0); }\r\n::-webkit-scrollbar-thumb:hover { background: var(--line-2); }\r\n\r\n/* Layout primitives */\r\n.panel {\r\n  background: linear-gradient(180deg, var(--bg-1), var(--bg-1));\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n.panel-hd {\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  padding: 10px 14px;\r\n  border-bottom: 1px solid var(--line-1);\r\n  background: var(--bg-2);\r\n}\r\n.panel-hd-title {\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-1);\r\n  display: flex; align-items: center; gap: 8px;\r\n}\r\n.panel-hd-title .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-3); }\r\n.panel-bd { padding: 14px; }\r\n\r\n/* Badge */\r\n.badge {\r\n  display: inline-flex; align-items: center; gap: 6px;\r\n  padding: 3px 8px;\r\n  border-radius: 4px;\r\n  font-size: 11px;\r\n  font-family: var(--mono);\r\n  letter-spacing: 0.04em;\r\n  background: var(--bg-2);\r\n  border: 1px solid var(--line-1);\r\n  color: var(--ink-1);\r\n  white-space: nowrap;\r\n}\r\n.badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }\r\n.badge.ok    { color: var(--teal); border-color: rgba(76,214,179,0.25); background: rgba(76,214,179,0.06); }\r\n.badge.warn  { color: var(--amber); border-color: rgba(240,179,90,0.25); background: rgba(240,179,90,0.06); }\r\n.badge.err   { color: var(--red); border-color: rgba(255,107,107,0.28); background: rgba(255,107,107,0.06); }\r\n.badge.run   { color: var(--amber); border-color: rgba(240,179,90,0.35); background: rgba(240,179,90,0.08); }\r\n.badge.idle  { color: var(--ink-1); }\r\n.badge.done  { color: var(--teal); border-color: rgba(76,214,179,0.25); background: rgba(76,214,179,0.06); }\r\n\r\n/* Buttons */\r\n.btn {\r\n  display: inline-flex; align-items: center; gap: 8px;\r\n  padding: 7px 12px;\r\n  border-radius: 5px;\r\n  border: 1px solid var(--line-2);\r\n  background: var(--bg-2);\r\n  color: var(--ink-0);\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  transition: background .12s, border-color .12s, transform .06s;\r\n}\r\n.btn:hover { background: var(--bg-3); border-color: #3a4656; }\r\n.btn:active { transform: translateY(1px); }\r\n.btn:disabled { opacity: 0.42; cursor: not-allowed; }\r\n.btn.primary {\r\n  background: linear-gradient(180deg, rgba(76,214,179,0.18), rgba(76,214,179,0.10));\r\n  border-color: rgba(76,214,179,0.45);\r\n  color: #c8f5e6;\r\n}\r\n[data-theme=\"light\"] .btn.primary {\r\n  background: linear-gradient(180deg, rgba(13,155,120,0.16), rgba(13,155,120,0.08));\r\n  border-color: rgba(13,155,120,0.55);\r\n  color: var(--teal);\r\n  font-weight: 600;\r\n}\r\n.btn.primary:hover { background: linear-gradient(180deg, rgba(76,214,179,0.26), rgba(76,214,179,0.14)); }\r\n[data-theme=\"light\"] .btn.primary:hover { background: linear-gradient(180deg, rgba(13,155,120,0.24), rgba(13,155,120,0.14)); }\r\n.btn.danger {\r\n  background: rgba(255,107,107,0.08);\r\n  border-color: rgba(255,107,107,0.32);\r\n  color: #ffc1c1;\r\n}\r\n[data-theme=\"light\"] .btn.danger { color: var(--red); font-weight: 600; }\r\n.btn.danger:hover { background: rgba(255,107,107,0.14); }\r\n.btn.ghost { background: transparent; border-color: var(--line-1); color: var(--ink-1); }\r\n.btn.ghost:hover { color: var(--ink-0); border-color: var(--line-2); }\r\n.btn.lg { padding: 10px 18px; font-size: 13px; }\r\n.btn.sm { padding: 4px 8px; font-size: 11px; }\r\n\r\n/* Form controls */\r\n.field { display: flex; flex-direction: column; gap: 4px; }\r\n.field label {\r\n  font-size: 11px;\r\n  color: var(--ink-1);\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  font-weight: 500;\r\n}\r\n.field .help { font-size: 11px; color: var(--ink-2); line-height: 1.5; }\r\n.input, .select {\r\n  background: var(--bg-0);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 5px;\r\n  padding: 8px 10px;\r\n  color: var(--ink-0);\r\n  font-family: var(--mono);\r\n  font-size: 12px;\r\n  outline: none;\r\n  transition: border-color .12s;\r\n}\r\n.input:focus, .select:focus { border-color: var(--teal-dim); }\r\n.input::placeholder { color: var(--ink-3); }\r\n\r\n/* Toggle */\r\n.toggle {\r\n  position: relative;\r\n  width: 34px; height: 18px;\r\n  border-radius: 999px;\r\n  background: var(--bg-3);\r\n  border: 1px solid var(--line-2);\r\n  transition: background .15s, border-color .15s;\r\n  flex-shrink: 0;\r\n}\r\n.toggle::after {\r\n  content: \"\"; position: absolute;\r\n  top: 2px; left: 2px;\r\n  width: 12px; height: 12px;\r\n  border-radius: 50%;\r\n  background: var(--ink-1);\r\n  transition: left .15s, background .15s;\r\n}\r\n.toggle.on { background: rgba(76,214,179,0.20); border-color: rgba(76,214,179,0.45); }\r\n.toggle.on::after { left: 18px; background: var(--teal); }\r\n\r\n/* Pulse for running indicator */\r\n@keyframes pulse {\r\n  0%,100% { opacity: 1; transform: scale(1); }\r\n  50% { opacity: 0.4; transform: scale(0.85); }\r\n}\r\n.pulse-dot { animation: pulse 1.4s ease-in-out infinite; }\r\n@keyframes scan {\r\n  0% { transform: translateX(-100%); }\r\n  100% { transform: translateX(100%); }\r\n}\r\n.scanbar {\r\n  position: relative;\r\n  height: 2px;\r\n  background: var(--line-1);\r\n  overflow: hidden;\r\n  border-radius: 2px;\r\n}\r\n.scanbar::after {\r\n  content: \"\";\r\n  position: absolute; inset: 0;\r\n  background: linear-gradient(90deg, transparent, var(--amber), transparent);\r\n  animation: scan 1.6s ease-in-out infinite;\r\n  width: 40%;\r\n}\r\n\r\n/* Tables */\r\ntable.gens { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 12px; }\r\ntable.gens thead th {\r\n  text-align: left;\r\n  font-weight: 500;\r\n  font-family: var(--sans);\r\n  font-size: 10.5px;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-2);\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid var(--line-1);\r\n  background: var(--bg-2);\r\n  position: sticky; top: 0; z-index: 1;\r\n}\r\ntable.gens tbody td {\r\n  padding: 9px 12px;\r\n  border-bottom: 1px solid var(--line-1);\r\n  color: var(--ink-0);\r\n  vertical-align: top;\r\n}\r\ntable.gens tbody tr:hover td { background: var(--bg-2); }\r\ntable.gens tbody tr.current td { background: rgba(240,179,90,0.06); }\r\ntable.gens tbody tr.current td:first-child { box-shadow: inset 2px 0 0 var(--amber); }\r\n.gist-cell { color: var(--ink-1); max-width: 360px; }\r\n.gist-cell.expanded { white-space: pre-wrap; }\r\n.gist-cell.truncated { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\r\n\r\n/* Numeric */\r\n.num-pos { color: var(--teal); }\r\n.num-neg { color: var(--red); }\r\n.num-warn { color: var(--amber); }\r\n.num-muted { color: var(--ink-2); }\r\n\r\n/* Big stat */\r\n.stat { display: flex; flex-direction: column; gap: 2px; }\r\n.stat-label { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); }\r\n.stat-value { font-family: var(--mono); font-size: 22px; color: var(--ink-0); font-feature-settings: \"tnum\" 1; }\r\n.stat-value.lg { font-size: 28px; }\r\n.stat-sub { font-size: 11px; color: var(--ink-2); font-family: var(--mono); }\r\n\r\n/* Modal */\r\n.modal-bd {\r\n  position: fixed; inset: 0;\r\n  background: rgba(4,6,9,0.72);\r\n  backdrop-filter: blur(4px);\r\n  display: flex; align-items: center; justify-content: center;\r\n  z-index: 50;\r\n  animation: fadeIn .15s ease-out;\r\n}\r\n[data-theme=\"light\"] .modal-bd { background: rgba(20,28,40,0.42); }\r\n@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }\r\n.modal {\r\n  width: min(720px, calc(100vw - 32px));\r\n  max-height: calc(100vh - 64px);\r\n  background: var(--bg-1);\r\n  border: 1px solid var(--line-2);\r\n  border-radius: 10px;\r\n  display: flex; flex-direction: column;\r\n  box-shadow: 0 30px 60px rgba(0,0,0,0.5);\r\n  overflow: hidden;\r\n}\r\n.modal-hd {\r\n  padding: 16px 20px;\r\n  border-bottom: 1px solid var(--line-1);\r\n  display: flex; align-items: center; justify-content: space-between;\r\n}\r\n.modal-hd h2 { font-size: 14px; font-weight: 500; letter-spacing: 0.04em; }\r\n.modal-hd h2 .sub { color: var(--ink-2); font-weight: 400; margin-left: 8px; font-size: 12px; }\r\n.modal-bd-content { padding: 20px; overflow-y: auto; }\r\n.modal-ft {\r\n  padding: 14px 20px;\r\n  border-top: 1px solid var(--line-1);\r\n  background: var(--bg-2);\r\n  display: flex; justify-content: flex-end; gap: 8px;\r\n}\r\n\r\n/* Group header in form */\r\n.group-title {\r\n  font-size: 10.5px;\r\n  letter-spacing: 0.14em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-2);\r\n  font-weight: 500;\r\n  padding-bottom: 6px;\r\n  border-bottom: 1px dashed var(--line-1);\r\n  margin-bottom: 10px;\r\n}\r\n.group + .group { margin-top: 22px; }\r\n.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\r\n@media (max-width: 560px) { .field-row { grid-template-columns: 1fr; } }\r\n\r\n/* Connection toolbar */\r\n.toolbar-input {\r\n  font-family: var(--mono);\r\n  font-size: 11px;\r\n  background: var(--bg-0);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 4px;\r\n  padding: 4px 7px;\r\n  color: var(--ink-1);\r\n  width: 180px;\r\n  outline: none;\r\n}\r\n.toolbar-input:focus { border-color: var(--line-2); color: var(--ink-0); }\r\n\r\n/* Top bar progress */\r\n.progress-track {\r\n  position: relative;\r\n  height: 4px;\r\n  background: var(--line-1);\r\n  border-radius: 2px;\r\n  overflow: hidden;\r\n  width: 100%;\r\n}\r\n.progress-fill {\r\n  position: absolute; inset: 0 auto 0 0;\r\n  background: linear-gradient(90deg, var(--teal-dim), var(--teal));\r\n  transition: width .4s cubic-bezier(.2,.7,.2,1);\r\n}\r\n.progress-fill.running { background: linear-gradient(90deg, var(--amber-dim), var(--amber)); }\r\n\r\n/* Tag pills */\r\n.pill {\r\n  display: inline-flex; align-items: center; gap: 4px;\r\n  padding: 2px 7px;\r\n  border-radius: 3px;\r\n  font-size: 10.5px;\r\n  font-family: var(--mono);\r\n  background: var(--bg-2);\r\n  color: var(--ink-1);\r\n  border: 1px solid var(--line-1);\r\n}\r\n.pill.gate-pass { color: var(--teal); border-color: rgba(76,214,179,0.32); background: rgba(76,214,179,0.08); }\r\n.pill.gate-fail { color: var(--ink-2); }\r\n.pill.success { color: var(--teal); }\r\n.pill.error { color: var(--red); border-color: rgba(255,107,107,0.28); background: rgba(255,107,107,0.06); }\r\n\r\n/* Gauge */\r\n.gauge { position: relative; height: 8px; background: var(--bg-0); border-radius: 4px; overflow: hidden; border: 1px solid var(--line-1); }\r\n.gauge-fill { position: absolute; inset: 0 auto 0 0; background: linear-gradient(90deg, var(--teal), var(--blue)); transition: width .5s ease; }\r\n.gauge-fill.warn { background: linear-gradient(90deg, var(--amber), var(--red)); }\r\n\r\n/* Live blink */\r\n@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }\r\n.blink { animation: blink 1.2s ease-in-out infinite; }\r\n\r\n/* Chart */\r\n.chart-wrap { position: relative; width: 100%; }\r\n.chart-wrap svg { display: block; width: 100%; height: auto; }\r\n.chart-grid-line { stroke: var(--line-1); stroke-width: 1; stroke-dasharray: 2 4; }\r\n.chart-axis-text { fill: var(--ink-2); font-family: var(--mono); font-size: 10px; }\r\n.chart-area { fill: url(#chart-area-grad); opacity: 0.35; }\r\n.chart-line { fill: none; stroke: var(--teal); stroke-width: 1.5; }\r\n.chart-best-line { stroke: var(--violet); stroke-width: 1; stroke-dasharray: 4 4; fill: none; }\r\n.chart-gate-line { stroke: rgba(76,214,179,0.35); stroke-width: 1; stroke-dasharray: 2 3; fill: none; }\r\n.chart-pt { fill: var(--teal); }\r\n.chart-pt-gate { fill: var(--violet); stroke: #fff; stroke-width: 1; }\r\n.chart-pt-curr { fill: var(--amber); stroke: var(--bg-0); stroke-width: 2; }\r\n\r\n/* Section grid */\r\n.grid-main {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 360px;\r\n  gap: 14px;\r\n}\r\n@media (max-width: 1180px) { .grid-main { grid-template-columns: 1fr; } }\r\n\r\n.row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\r\n@media (max-width: 900px) { .row-2 { grid-template-columns: 1fr; } }\r\n\r\n/* Empty state */\r\n.empty {\r\n  border: 1px dashed var(--line-2);\r\n  border-radius: 10px;\r\n  padding: 40px 24px;\r\n  text-align: center;\r\n  color: var(--ink-2);\r\n}\r\n.empty h2 { color: var(--ink-0); font-size: 18px; margin-bottom: 6px; }\r\n.empty p { margin: 0 0 20px; line-height: 1.6; }\r\n\r\n/* Tooltip-ish hover */\r\n[data-tip] { position: relative; }\r\n[data-tip]:hover::after {\r\n  content: attr(data-tip);\r\n  position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%);\r\n  background: var(--bg-3); color: var(--ink-0);\r\n  padding: 5px 8px; border-radius: 4px;\r\n  font-size: 11px; white-space: nowrap;\r\n  border: 1px solid var(--line-2);\r\n  z-index: 5;\r\n  pointer-events: none;\r\n}\r\n\r\n/* ====== Engine status panel ====== */\r\n.engine-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 1px;\r\n  background: var(--line-1);\r\n  border-radius: 6px;\r\n  overflow: hidden;\r\n  border: 1px solid var(--line-1);\r\n}\r\n@media (max-width: 700px) { .engine-grid { grid-template-columns: repeat(2, 1fr); } }\r\n.engine-cell {\r\n  background: var(--bg-1);\r\n  padding: 11px 12px;\r\n  display: flex; flex-direction: column; gap: 4px;\r\n}\r\n.engine-cell .lbl {\r\n  font-size: 10px;\r\n  letter-spacing: .12em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-2);\r\n  display: flex; align-items: center; gap: 6px;\r\n}\r\n.engine-cell .val {\r\n  font-family: var(--mono);\r\n  font-size: 17px;\r\n  color: var(--ink-0);\r\n  font-feature-settings: \"tnum\" 1;\r\n  display: flex; align-items: baseline; gap: 4px;\r\n}\r\n.engine-cell .val .unit { font-size: 11px; color: var(--ink-2); }\r\n.engine-cell .sub {\r\n  font-size: 10.5px;\r\n  color: var(--ink-3);\r\n  font-family: var(--mono);\r\n}\r\n\r\n/* Mini gauge bar inside engine cell */\r\n.mini-bar {\r\n  position: relative;\r\n  height: 3px;\r\n  background: var(--bg-0);\r\n  border-radius: 2px;\r\n  overflow: hidden;\r\n  margin-top: 4px;\r\n}\r\n.mini-bar > div {\r\n  position: absolute; inset: 0 auto 0 0;\r\n  background: linear-gradient(90deg, var(--teal), var(--blue));\r\n  transition: width .35s ease;\r\n}\r\n.mini-bar > div.warn { background: linear-gradient(90deg, var(--amber), var(--red)); }\r\n.mini-bar > div.cool { background: var(--ink-2); }\r\n\r\n/* Workers row */\r\n.workers-row {\r\n  display: flex; gap: 4px; flex-wrap: wrap;\r\n  margin-top: 4px;\r\n}\r\n.worker-pip {\r\n  width: 14px; height: 6px; border-radius: 2px;\r\n  background: var(--line-2);\r\n}\r\n.worker-pip.active { background: var(--amber); box-shadow: 0 0 6px rgba(240,179,90,0.5); }\r\n.worker-pip.idle   { background: var(--line-2); }\r\n\r\n/* ====== Code viewer ====== */\r\n.code-tabs {\r\n  display: flex; gap: 0;\r\n  border-bottom: 1px solid var(--line-1);\r\n  background: var(--bg-2);\r\n}\r\n.code-tab {\r\n  padding: 9px 16px;\r\n  font-size: 11.5px;\r\n  font-family: var(--mono);\r\n  color: var(--ink-2);\r\n  border-bottom: 2px solid transparent;\r\n  cursor: pointer;\r\n  letter-spacing: .04em;\r\n}\r\n.code-tab:hover { color: var(--ink-1); }\r\n.code-tab.active { color: var(--ink-0); border-bottom-color: var(--teal); }\r\n\r\n.code-block {\r\n  margin: 0;\r\n  padding: 14px 16px;\r\n  background: var(--bg-0);\r\n  font-family: var(--mono);\r\n  font-size: 12px;\r\n  line-height: 1.55;\r\n  color: var(--ink-0);\r\n  overflow-x: auto;\r\n  max-height: 480px;\r\n  overflow-y: auto;\r\n  white-space: pre;\r\n  tab-size: 4;\r\n}\r\n.code-block .tok-kw { color: var(--violet); }\r\n.code-block .tok-str { color: var(--teal); }\r\n.code-block .tok-num { color: var(--amber); }\r\n.code-block .tok-com { color: var(--ink-3); font-style: italic; }\r\n.code-block .tok-fn { color: var(--blue); }\r\n.code-block .ln {\r\n  display: inline-block; width: 28px; text-align: right;\r\n  margin-right: 12px; color: var(--ink-3);\r\n  user-select: none;\r\n}\r\n\r\n/* ====== Theme toggle ====== */\r\n.theme-toggle {\r\n  display: inline-flex;\r\n  background: var(--bg-1);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 5px;\r\n  padding: 2px;\r\n}\r\n.theme-toggle button {\r\n  padding: 4px 8px;\r\n  font-size: 11px;\r\n  color: var(--ink-2);\r\n  border-radius: 3px;\r\n  display: inline-flex; align-items: center; gap: 4px;\r\n}\r\n.theme-toggle button.active {\r\n  background: var(--bg-3);\r\n  color: var(--ink-0);\r\n}\r\n\r\n/* ====== Equity / drawdown live mini-chart ====== */\r\n.live-chart-wrap { position: relative; }\r\n.live-chart-wrap svg { display: block; width: 100%; height: auto; }\r\n.eq-line { fill: none; stroke: var(--teal); stroke-width: 1.4; }\r\n.eq-line-neg { stroke: var(--red); }\r\n.eq-area { fill: url(#eq-grad); opacity: 0.35; }\r\n.dd-area { fill: url(#dd-grad); opacity: 0.5; }\r\n.dd-line { fill: none; stroke: var(--red); stroke-width: 1; opacity: 0.7; }\r\n.trade-marker-buy { fill: var(--teal); }\r\n.trade-marker-sell { fill: var(--amber); }\r\n.zero-line { stroke: var(--line-2); stroke-width: 1; stroke-dasharray: 3 3; }\r\n\r\n/* Slim tag */\r\n.tag-slim {\r\n  display: inline-flex; align-items: center; gap: 4px;\r\n  padding: 1px 6px;\r\n  border-radius: 3px;\r\n  font-size: 10px;\r\n  font-family: var(--mono);\r\n  background: var(--bg-2);\r\n  color: var(--ink-2);\r\n  border: 1px solid var(--line-1);\r\n  letter-spacing: .04em;\r\n}\r\n\r\n/* Themed alert (red/warning) */\r\n.alert-danger {\r\n  padding: 12px;\r\n  border: 1px solid rgba(255,107,107,0.32);\r\n  background: rgba(255,107,107,0.06);\r\n  border-radius: 6px;\r\n  color: #ffd0d0;\r\n  font-size: 12px;\r\n  line-height: 1.55;\r\n}\r\n[data-theme=\"light\"] .alert-danger {\r\n  color: #6c1b1b;\r\n  background: rgba(214,61,61,0.07);\r\n  border-color: rgba(214,61,61,0.30);\r\n}\r\n.alert-danger strong { color: var(--red); }\r\n\r\n/* ====== Phase Timeline ====== */\r\n.phase-timeline {\r\n  display: flex; align-items: stretch; gap: 0;\r\n  padding: 12px 16px;\r\n  background: var(--bg-1);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 8px;\r\n  position: relative;\r\n}\r\n.phase-step {\r\n  display: flex; align-items: center; gap: 10px;\r\n  padding: 6px 8px;\r\n  position: relative;\r\n  flex-shrink: 0;\r\n}\r\n.phase-num {\r\n  width: 26px; height: 26px;\r\n  border-radius: 50%;\r\n  background: var(--bg-2);\r\n  border: 1px solid var(--line-2);\r\n  display: flex; align-items: center; justify-content: center;\r\n  font-family: var(--mono);\r\n  font-size: 11px;\r\n  color: var(--ink-2);\r\n  font-weight: 500;\r\n  flex-shrink: 0;\r\n  transition: all .2s;\r\n}\r\n.phase-step.done .phase-num {\r\n  background: rgba(76,214,179,0.14);\r\n  border-color: var(--teal);\r\n  color: var(--teal);\r\n}\r\n.phase-step.active .phase-num {\r\n  background: rgba(240,179,90,0.18);\r\n  border-color: var(--amber);\r\n  color: var(--amber);\r\n  box-shadow: 0 0 0 4px rgba(240,179,90,0.10);\r\n}\r\n.phase-step-text { line-height: 1.15; }\r\n.phase-step-label {\r\n  font-size: 12px;\r\n  color: var(--ink-1);\r\n  font-weight: 500;\r\n}\r\n.phase-step.active .phase-step-label { color: var(--ink-0); }\r\n.phase-step.done .phase-step-label { color: var(--ink-1); }\r\n.phase-step.pending .phase-step-label { color: var(--ink-2); }\r\n.phase-step-sub {\r\n  font-size: 10px;\r\n  color: var(--ink-3);\r\n  font-family: var(--mono);\r\n  letter-spacing: .04em;\r\n}\r\n.phase-active-pulse {\r\n  position: absolute;\r\n  left: -2px; top: -2px; right: -2px; bottom: -2px;\r\n  border-radius: 6px;\r\n  pointer-events: none;\r\n}\r\n.phase-connector {\r\n  flex: 1;\r\n  height: 1px;\r\n  margin: 0 4px;\r\n  align-self: center;\r\n  background: var(--line-1);\r\n  border-radius: 1px;\r\n  position: relative;\r\n  overflow: hidden;\r\n  min-width: 12px;\r\n}\r\n.phase-connector-fill {\r\n  position: absolute; inset: 0 auto 0 0;\r\n  background: var(--teal);\r\n  transition: width .35s ease;\r\n}\r\n.phase-connector.done .phase-connector-fill { width: 100%; }\r\n.phase-gen-tag {\r\n  margin-left: auto;\r\n  align-self: center;\r\n  font-size: 11px;\r\n  font-family: var(--mono);\r\n  color: var(--ink-1);\r\n  padding: 4px 10px;\r\n  background: var(--bg-2);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 4px;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* ====== Process Flow Panel ====== */\r\n.process-flow-row {\r\n  display: flex;\r\n  align-items: stretch;\r\n  gap: 0;\r\n  padding: 10px 14px;\r\n  background: var(--bg-1);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 8px;\r\n  overflow-x: auto;\r\n}\r\n.process-box {\r\n  flex: 1;\r\n  min-width: 80px;\r\n  padding: 8px 10px;\r\n  border-radius: 6px;\r\n  border: 1px solid var(--line-1);\r\n  background: var(--bg-2);\r\n  text-align: center;\r\n  font-size: 12px;\r\n  color: var(--ink-2);\r\n  font-family: var(--sans);\r\n  font-weight: 500;\r\n  transition: border-color .2s, color .2s, background .2s, box-shadow .2s;\r\n  position: relative;\r\n}\r\n.process-box + .process-box {\r\n  margin-left: 6px;\r\n}\r\n.process-box .process-box-sub {\r\n  display: block;\r\n  font-size: 9.5px;\r\n  font-family: var(--mono);\r\n  color: var(--ink-3);\r\n  letter-spacing: .05em;\r\n  margin-top: 2px;\r\n}\r\n.process-box.active {\r\n  border-color: var(--amber);\r\n  color: var(--amber);\r\n  background: rgba(240,179,90,0.10);\r\n  box-shadow: 0 0 0 3px rgba(240,179,90,0.12);\r\n}\r\n.process-box.active .process-box-sub { color: var(--amber); opacity: .7; }\r\n/* Log pane */\r\n.process-log-pane {\r\n  margin-top: 8px;\r\n  padding: 8px 10px;\r\n  background: var(--bg-2);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 6px;\r\n  max-height: 200px;\r\n  overflow-y: auto;\r\n  font-family: var(--mono);\r\n  font-size: 10.5px;\r\n  color: var(--ink-2);\r\n  line-height: 1.55;\r\n}\r\n.process-log-empty {\r\n  color: var(--ink-3);\r\n  font-style: italic;\r\n}\r\n\r\n/* ====== Phase Detail Panel ====== */\r\n.phase-detail .panel-bd { padding: 0; }\r\n\r\n/* Generation view */\r\n.gen-view-grid {\r\n  display: grid;\r\n  grid-template-columns: 280px 1fr;\r\n}\r\n@media (max-width: 900px) { .gen-view-grid { grid-template-columns: 1fr; } }\r\n.gen-side {\r\n  padding: 14px 16px;\r\n  border-right: 1px solid var(--line-1);\r\n  display: flex; flex-direction: column; gap: 16px;\r\n}\r\n@media (max-width: 900px) {\r\n  .gen-side { border-right: none; border-bottom: 1px solid var(--line-1); }\r\n}\r\n.side-section-title {\r\n  font-size: 10px;\r\n  letter-spacing: .14em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-2);\r\n  font-weight: 500;\r\n  margin-bottom: 6px;\r\n}\r\n.side-kv {\r\n  display: grid;\r\n  grid-template-columns: 70px 1fr;\r\n  gap: 4px 10px;\r\n  font-size: 11.5px;\r\n}\r\n.side-kv .k { color: var(--ink-3); font-family: var(--mono); }\r\n.side-kv .v { color: var(--ink-0); }\r\n.side-list {\r\n  margin: 0; padding: 0; list-style: none;\r\n  display: flex; flex-direction: column; gap: 6px;\r\n}\r\n.side-list li {\r\n  padding: 6px 8px;\r\n  background: var(--bg-0);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 4px;\r\n  color: var(--ink-1);\r\n  line-height: 1.5;\r\n}\r\n.side-empty {\r\n  font-size: 11px; color: var(--ink-3); font-style: italic;\r\n  padding: 6px 0;\r\n}\r\n.gen-prog-row {\r\n  display: flex; align-items: center; gap: 8px;\r\n  padding: 4px 0;\r\n}\r\n.gen-prog-dot {\r\n  width: 8px; height: 8px; border-radius: 50%;\r\n  background: var(--line-2);\r\n  flex-shrink: 0;\r\n}\r\n.gen-prog-dot.active { background: var(--amber); animation: pulse 1.2s ease-in-out infinite; }\r\n.gen-prog-dot.done { background: var(--teal); }\r\n.gen-prog-label { font-size: 12px; color: var(--ink-1); flex: 1; }\r\n.gen-prog-state { font-size: 12px; color: var(--ink-3); width: 14px; text-align: center; }\r\n.gen-prog-state.done { color: var(--teal); }\r\n\r\n.gen-code-col {\r\n  display: flex; flex-direction: column; min-width: 0;\r\n}\r\n.gen-code-header {\r\n  display: flex; align-items: center; gap: 8px;\r\n  padding: 9px 14px;\r\n  background: var(--bg-2);\r\n  border-bottom: 1px solid var(--line-1);\r\n}\r\n.code-block.stream {\r\n  border: none;\r\n  max-height: 360px;\r\n  min-height: 240px;\r\n  position: relative;\r\n}\r\n.stream-caret {\r\n  display: inline-block;\r\n  color: var(--amber);\r\n  font-family: var(--mono);\r\n  margin-left: 1px;\r\n  font-weight: 700;\r\n}\r\n\r\n/* Backtesting view */\r\n.bt-view { display: flex; flex-direction: column; }\r\n.bt-summary-row {\r\n  display: grid; grid-template-columns: repeat(4, 1fr);\r\n  gap: 1px;\r\n  background: var(--line-1);\r\n  border-bottom: 1px solid var(--line-1);\r\n}\r\n@media (max-width: 700px) { .bt-summary-row { grid-template-columns: repeat(2, 1fr); } }\r\n.summary-cell {\r\n  background: var(--bg-1);\r\n  padding: 12px 14px;\r\n  display: flex; flex-direction: column; gap: 3px;\r\n}\r\n.summary-lbl {\r\n  font-size: 10px;\r\n  letter-spacing: .12em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-2);\r\n}\r\n.summary-val { font-size: 17px; color: var(--ink-0); font-family: var(--mono); }\r\n.summary-sub { font-size: 10.5px; color: var(--ink-3); }\r\n.bt-chart-embed { padding: 14px 14px; }\r\n.chart-empty {\r\n  position: absolute; inset: 0;\r\n  display: flex; align-items: center; justify-content: center;\r\n  color: var(--ink-3); font-size: 12px; font-family: var(--mono);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Scoring view */\r\n.score-view { padding: 14px 16px; display: flex; flex-direction: column; gap: 16px; }\r\n.score-formula {\r\n  display: flex; align-items: center; gap: 6px;\r\n  padding: 10px 12px;\r\n  background: var(--bg-0);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 5px;\r\n  font-size: 12px;\r\n}\r\n.score-metrics {\r\n  display: flex; flex-direction: column; gap: 10px;\r\n}\r\n.score-metric {\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--line-1);\r\n  background: var(--bg-1);\r\n  border-radius: 5px;\r\n  transition: opacity .2s, border-color .2s;\r\n}\r\n.score-metric.pending { opacity: 0.45; border-style: dashed; }\r\n.score-metric.ready { border-color: var(--line-2); }\r\n.metric-row {\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  margin-bottom: 6px;\r\n  font-size: 12px;\r\n}\r\n.metric-label { color: var(--ink-0); }\r\n.metric-weight {\r\n  font-family: var(--mono); font-size: 10.5px; color: var(--ink-2);\r\n  background: var(--bg-2); padding: 1px 6px; border-radius: 3px;\r\n}\r\n.metric-bar-wrap {\r\n  display: flex; align-items: center; gap: 10px;\r\n}\r\n.metric-bar {\r\n  flex: 1;\r\n  height: 6px;\r\n  background: var(--bg-0);\r\n  border-radius: 3px; overflow: hidden;\r\n  border: 1px solid var(--line-1);\r\n}\r\n.metric-bar-fill {\r\n  height: 100%;\r\n  background: linear-gradient(90deg, var(--teal-dim), var(--teal));\r\n  transition: width .4s ease;\r\n}\r\n.metric-val {\r\n  font-size: 12px; color: var(--ink-0);\r\n  width: 50px; text-align: right;\r\n}\r\n.metric-weighted {\r\n  font-size: 11px; color: var(--ink-2);\r\n  width: 70px; text-align: right;\r\n}\r\n.score-composite {\r\n  display: flex; align-items: baseline; gap: 12px;\r\n  padding: 12px 14px;\r\n  background: linear-gradient(180deg, rgba(76,214,179,0.05), transparent);\r\n  border: 1px solid var(--line-2);\r\n  border-radius: 6px;\r\n}\r\n.composite-label {\r\n  font-size: 11px;\r\n  letter-spacing: .12em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-2);\r\n}\r\n.composite-val {\r\n  font-size: 26px;\r\n  font-family: var(--mono);\r\n}\r\n\r\n/* Autopsy view */\r\n.autopsy-view {\r\n  padding: 14px 16px;\r\n  display: flex; flex-direction: column; gap: 10px;\r\n}\r\n.autopsy-header {\r\n  display: flex; align-items: center; gap: 6px;\r\n  padding-bottom: 6px;\r\n  border-bottom: 1px dashed var(--line-1);\r\n}\r\n.autopsy-body {\r\n  padding: 14px;\r\n  background: var(--bg-0);\r\n  border: 1px solid var(--line-1);\r\n  border-radius: 5px;\r\n  min-height: 120px;\r\n  font-family: var(--mono);\r\n  font-size: 13px;\r\n  color: var(--ink-0);\r\n  line-height: 1.7;\r\n  white-space: pre-wrap;\r\n}\r\n.autopsy-text { white-space: pre-wrap; }\r\n.autopsy-footnote {\n  font-size: 11px; color: var(--ink-2); line-height: 1.55;\n  padding: 6px 0;\n}\n\n/* Research Lab */\n.research-lab-shell {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.research-tabs {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 6px;\n}\n.research-tab {\n  min-height: 30px;\n  border: 1px solid var(--line-1);\n  background: var(--bg-1);\n  color: var(--ink-2);\n  border-radius: 5px;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  cursor: pointer;\n}\n.research-tab.active {\n  border-color: var(--teal-dim);\n  color: var(--teal);\n  background: rgba(76,214,179,0.08);\n}\n.research-lab-panel {\n  border: 1px solid var(--line-1);\n  background: var(--bg-1);\n  border-radius: 6px;\n  padding: 12px;\n}\n.research-controls {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n.research-controls label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.research-controls select {\n  border: 1px solid var(--line-1);\n  background: var(--bg-0);\n  color: var(--ink-0);\n  border-radius: 4px;\n  padding: 4px 6px;\n  font-family: var(--mono);\n  font-size: 11px;\n}\n.research-kpis {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  color: var(--ink-3);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.research-empty {\n  padding: 22px 12px;\n  color: var(--ink-3);\n  font-family: var(--mono);\n  font-size: 11px;\n  line-height: 1.55;\n  text-align: center;\n}\n.research-heatmap {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));\n  gap: 6px;\n}\n.research-cell {\n  min-height: 62px;\n  border-radius: 5px;\n  padding: 7px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  color: #fff;\n  overflow: hidden;\n}\n.research-cell strong {\n  font-size: 10px;\n  line-height: 1.25;\n  word-break: break-word;\n}\n.research-cell span {\n  font-family: var(--mono);\n  font-size: 16px;\n  font-weight: 700;\n}\n.research-cell small,\n.research-combo-row small,\n.research-muted {\n  color: var(--ink-3);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n.research-combo-list {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.research-combo-row {\n  display: grid;\n  grid-template-columns: minmax(70px, 1fr) 12px minmax(70px, 1fr) 56px 86px;\n  gap: 6px;\n  align-items: center;\n  border-bottom: 1px solid var(--line-1);\n  padding: 5px 0;\n  font-size: 10.5px;\n}\n\n/* Strategy inspector */\n.strategy-inspector {\n  margin-top: 10px;\n  border: 1px solid var(--line-1);\n  border-radius: 6px;\n  background: var(--bg-1);\n  overflow: hidden;\n}\n.strategy-inspector-tabs {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 1px;\n  background: var(--line-1);\n}\n.strategy-inspector-tabs button {\n  border: 0;\n  background: var(--bg-0);\n  color: var(--ink-2);\n  min-height: 30px;\n  cursor: pointer;\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.strategy-inspector-tabs button.active {\n  color: var(--teal);\n  background: rgba(76,214,179,0.08);\n}\n.strategy-inspector-body {\n  padding: 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.strategy-kpis,\n.strategy-prompt-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.strategy-section-title {\n  color: var(--ink-1);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n}\n.strategy-empty {\n  padding: 12px;\n  color: var(--ink-3);\n  font-family: var(--mono);\n  font-size: 11px;\n  line-height: 1.5;\n}\n.strategy-empty.danger { color: var(--red); }\n.strategy-diff-block,\n.strategy-prompt-row {\n  border: 1px solid var(--line-1);\n  border-radius: 5px;\n  background: var(--bg-0);\n  padding: 8px;\n}\n.strategy-diff-lines,\n.strategy-json,\n.strategy-context {\n  margin: 6px 0 0;\n  max-height: 220px;\n  overflow: auto;\n  white-space: pre-wrap;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-height: 1.45;\n  color: var(--ink-1);\n}\n.strategy-diff-lines .add { color: var(--teal); }\n.strategy-diff-lines .del { color: var(--red); }\n.strategy-diff-lines .meta { color: var(--amber); }\n.strategy-prompt-head {\n  margin-top: 6px;\n  color: var(--ink-1);\n  font-size: 11px;\n  line-height: 1.55;\n  word-break: break-word;\n}\n.strategy-context {\n  border: 1px solid var(--line-1);\n  border-radius: 5px;\n  background: var(--bg-0);\n  padding: 8px;\n}\n\n/* Run compare console */\n.run-compare-shell {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.run-compare-kpis,\n.run-compare-gen {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.run-compare-scroll {\n  overflow-x: auto;\n}\n.run-compare-table {\n  width: 100%;\n  min-width: 1320px;\n  border-collapse: collapse;\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.run-compare-table th,\n.run-compare-table td {\n  padding: 5px 7px;\n  border-top: 1px solid var(--line-1);\n  text-align: left;\n  white-space: nowrap;\n}\n.run-compare-table th {\n  color: var(--ink-3);\n  background: var(--bg-0);\n  position: sticky;\n  top: 0;\n}\n.run-compare-empty {\n  padding: 14px;\n  color: var(--ink-3);\n  font-size: 12px;\n  line-height: 1.6;\n}\n.run-compare-empty.danger {\n  color: var(--red);\n}\n\n/* Metric explanations and runtime summaries */\n.metric-help-strip,\n.engine-summary-strip,\n.engine-config-strip,\n.engine-log-strip {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin: 8px 0 10px;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-height: 1.45;\n}\n.metric-help-strip span,\n.engine-summary-strip span,\n.engine-config-strip span,\n.engine-log-strip span {\n  border: 1px solid var(--line-1);\n  background: var(--bg-0);\n  border-radius: 4px;\n  padding: 3px 6px;\n}\n.engine-summary-strip b,\n.engine-config-strip b,\n.engine-log-strip b {\n  color: var(--ink-0);\n  font-weight: 600;\n}\n\n/* Research wiki */\n.research-wiki-note {\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-height: 1.5;\n  margin-bottom: 10px;\n}\n.research-wiki-layout {\n  display: grid;\n  grid-template-columns: minmax(160px, 0.9fr) minmax(0, 1.6fr);\n  gap: 10px;\n}\n.research-wiki-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-height: 520px;\n  overflow: auto;\n}\n.research-wiki-category {\n  border: 1px solid var(--line-1);\n  border-radius: 5px;\n  background: var(--bg-0);\n  padding: 7px;\n}\n.research-wiki-category-title {\n  color: var(--ink-1);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n  margin-bottom: 5px;\n}\n.research-wiki-category button {\n  width: 100%;\n  border: 0;\n  background: transparent;\n  color: var(--ink-2);\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  align-items: flex-start;\n  text-align: left;\n  padding: 5px 4px;\n  border-radius: 4px;\n  cursor: pointer;\n}\n.research-wiki-category button.active {\n  color: var(--teal);\n  background: rgba(76,214,179,0.08);\n}\n.research-wiki-category small,\n.research-wiki-muted {\n  color: var(--ink-3);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n.research-wiki-doc {\n  min-width: 0;\n  border: 1px solid var(--line-1);\n  border-radius: 5px;\n  background: var(--bg-0);\n  overflow: hidden;\n}\n.research-wiki-doc-head {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  padding: 8px 10px;\n  border-bottom: 1px solid var(--line-1);\n}\n.research-wiki-doc-head strong {\n  color: var(--ink-0);\n  font-size: 12px;\n}\n.research-wiki-doc-head span {\n  color: var(--ink-3);\n  font-family: var(--mono);\n  font-size: 10px;\n  word-break: break-all;\n}\n.research-wiki-markdown {\n  margin: 0;\n  padding: 10px;\n  max-height: 460px;\n  overflow: auto;\n  white-space: pre-wrap;\n  color: var(--ink-1);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-height: 1.55;\n}\n.research-wiki-empty {\n  padding: 14px;\n  color: var(--ink-3);\n  font-size: 12px;\n  line-height: 1.6;\n}\n.research-wiki-empty.danger {\n  color: var(--red);\n}\n\n/* AI context pack */\n.ai-context-body {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.ai-context-kpis,\n.ai-context-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.ai-context-kpis span,\n.ai-context-actions span,\n.ai-context-actions strong {\n  border: 1px solid var(--line-1);\n  background: var(--bg-0);\n  border-radius: 4px;\n  padding: 3px 6px;\n}\n.ai-context-actions strong {\n  color: var(--ink-0);\n}\n.ai-context-summary {\n  margin: 0;\n  max-height: 220px;\n  overflow: auto;\n  white-space: pre-wrap;\n  border: 1px solid var(--line-1);\n  background: var(--bg-0);\n  border-radius: 5px;\n  padding: 8px;\n  color: var(--ink-1);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-