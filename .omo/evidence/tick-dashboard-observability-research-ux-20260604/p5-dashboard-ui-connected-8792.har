onnect\" href=\"https://fonts.googleapis.com\" />\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n  <link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\" />\r\n\r\n  <link rel=\"stylesheet\" href=\"styles.css?v=20260603a\" />\r\n\r\n  <!-- 로컬 번들(vendored) — unpkg CDN 의존 제거로 오프라인/캐시/SRI 문제 차단.\r\n       이전: unpkg react/react-dom/babel + SRI(integrity). 인터넷 불가/캐시 꼬임 시 검은 화면.\r\n       이제: 같은 origin 로컬 파일. 버전 쿼리(?v=)로 브라우저 캐시 강제 무효화. -->\r\n  <script src=\"vendor-react.js?v=20260603a\"></script>\r\n  <script src=\"vendor-react-dom.js?v=20260603a\"></script>\r\n  <script src=\"vendor-babel.js?v=20260603a\"></script>\r\n</head>\r\n<body>\r\n  <!-- React 마운트 전/실패 시 보이는 폴백(검은 화면 대신 안내). 마운트 성공 시 교체됨. -->\r\n  <div id=\"root\">\r\n    <div style=\"padding:40px;font-family:system-ui,sans-serif;color:#9fb0c0;background:#0c1014;min-height:100vh;\">\r\n      <div style=\"font-size:15px;margin-bottom:8px;\">STOM AI 대시보드 로딩 중…</div>\r\n      <div style=\"font-size:12px;color:#5f7080;\">\r\n        몇 초 이상 이 화면이 지속되면 <b>Ctrl+Shift+R</b>(강력 새로고침)을 눌러주세요.\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <script type=\"text/babel\" src=\"connection.jsx?v=20260603a\"></script>\n  <script type=\"text/babel\" src=\"panels.jsx?v=20260603a\"></script>\n  <script type=\"text/babel\" src=\"run-compare.jsx?v=20260603a\"></script>\n  <script type=\"text/babel\" src=\"engine.jsx?v=20260603a\"></script>\n  <script type=\"text/babel\" src=\"chart.jsx?v=20260603b\"></script>\r\n  <script type=\"text/babel\" src=\"hypothesis.jsx?v=20260603a\"></script>\r\n  <script type=\"text/babel\" src=\"table.jsx?v=20260603a\"></script>\n  <script type=\"text/babel\" src=\"cards.jsx?v=20260603a\"></script>\n  <script type=\"text/babel\" src=\"code-viewer.jsx?v=20260603a\"></script>\n  <script type=\"text/babel\" src=\"strategy-inspector.jsx?v=20260603a\"></script>\n  <s