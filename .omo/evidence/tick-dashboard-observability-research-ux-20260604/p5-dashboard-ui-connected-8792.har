1-01 ~ 2025-12-31\",\"timeframe\":\"tick\",\"duration_sec\":288.911,\"created_at\":1780574170.757327,\"buy_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g6_buy\",\"sell_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g6_sell\",\"graded_score\":0.285609,\"gate_passed\":false,\"mdd\":7.6,\"payoff_ratio\":1.644007,\"profit\":1343705.0,\"total_profit_pct\":26.87,\"return_pct\":26.87,\"trade_count\":136,\"daily_avg_trades\":0.2,\"max_hold_count\":0.0},{\"run_id\":\"tick_oosrob_p5_train_2023_2025_20260604\",\"gen_no\":7,\"status\":\"ok\",\"period\":\"2023-01-01 ~ 2025-12-31\",\"timeframe\":\"tick\",\"duration_sec\":302.502,\"created_at\":1780574473.2589405,\"buy_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g7_buy\",\"sell_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g7_sell\",\"graded_score\":0.063939,\"gate_passed\":false,\"mdd\":10.32,\"payoff_ratio\":1.85239,\"profit\":1378444.0,\"total_profit_pct\":27.57,\"return_pct\":27.57,\"trade_count\":91,\"daily_avg_trades\":0.1,\"max_hold_count\":0.0},{\"run_id\":\"tick_oosrob_p5_train_2023_2025_20260604\",\"gen_no\":8,\"status\":\"ok\",\"period\":\"2023-01-01 ~ 2025-12-31\",\"timeframe\":\"tick\",\"duration_sec\":297.026,\"created_at\":1780574770.2845576,\"buy_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g8_buy\",\"sell_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g8_sell\",\"graded_score\":0.171506,\"gate_passed\":false,\"mdd\":19.56,\"payoff_ratio\":1.479711,\"profit\":-313746.0,\"total_profit_pct\":-6.27,\"return_pct\":-6.27,\"trade_count\":149,\"daily_avg_trades\":0.2,\"max_hold_count\":0.0},{\"run_id\":\"tick_oosrob_p5_train_2023_2025_20260604\",\"gen_no\":9,\"status\":\"ok\",\"period\":\"2023-01-01 ~ 2025-12-31\",\"timeframe\":\"tick\",\"duration_sec\":303.256,\"created_at\":1780575073.540666,\"buy_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g9_buy\",\"sell_name\":\"AILOOP_tick_oosrob_p5_train_2023_2025_20260604_g9_sell\",\"graded_score\":0.122546,\"gate_passed\":false,\"mdd\":33.75,\"payoff_ratio\":1.634364,\"profit\":-1342087.0,\"total_profit_pct\":-26.84,\"return_pct\":-26.84,\"trade_count\":115,\"daily_avg_trades\":0.2,\"max_hold_count\":0.0}],\"count\":95,\"generation_count\":461}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":2.045}},{"startedDateTime":"2026-06-04T15:02:08.753Z","time":0.663,"request":{"method":"GET","url":"http://127.0.0.1:8792/config/spec","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8792"},{"name":"Referer","value":"http://127.0.0.1:8792/ui/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/148.0.7778.96 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"HeadlessChrome\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-length","value":"9012"},{"name":"content-type","value":"application/json"},{"name":"date","value":"Thu, 04 Jun 2026 15:02:07 GMT"},{"name":"server","value":"uvicorn"}],"content":{"size":-1,"mimeType":"application/json","text":"{\"contract_version\":2,\"fields\":[{\"name\":\"provider\",\"label\":\"LLM Provider\",\"type\":\"select\",\"choices\":[\"gpt_auth\",\"openrouter\",\"codex_proxy\"],\"default\":\"gpt_auth\",\"help\":\"전략 생성에 쓸 LLM provider. gpt_auth는 로컬 OAuth 프록시 경유.\"},{\"name\":\"model\",\"label\":\"Model\",\"type\":\"text\",\"default\":\"gpt-5.5\",\"help\":\"provider별 모델명 (예: gpt-5.5).\"},{\"name\":\"max_generations\",\"label\":\"Max Generations\",\"type\":\"number\",\"default\":20,\"help\":\"생성 세대 수 상한. 이 세대 수에 도달하면 루프가 종료한다.\"},{\"name\":\"target_score\",\"label\":\"Target Score\",\"type\":\"number\",\"default\":null,\"help\":\"비우면 점수 기반 조기 종료 없음. 값이 있으면 하드 게이트 통과 winner 점수가 이 값 이상일 때 조기 졸업 종료.\"},{\"name\":\"mdd_cap\",\"label\":\"MDD Cap (%)\",\"type\":\"number\",\"default\":35.0,\"help\":\"하드 게이트 경계: MDD가 이 값을 넘으면 게이트 실패.\"},{\"name\":\"min_trades\",\"label\":\"Min Trades\",\"type\":\"number\",\"default\":30,\"help\":\"하드 게이트 경계: 거래 수가 이 값 미만이면 게이트 실패.\"},{\"name\":\"bt_timeframe\",\"label\":\"Backtest Timeframe\",\"type\":\"select\",\"choices\":[\"min\",\"tick\"],\"default\":\"min\",\"help\":\"세대별 평가 백테스트 타임프레임. min(분봉)이 검증된 빠른 기본값.\"},{\"name\":\"full_session_enabled\",\"label\":\"MIN 풀세션(15시까지)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 min(분봉) 백테 장중 윈도우를 시초 28분이 아니라 풀세션(bt_min_universe_end_time)까지 연다. tick은 데이터 09:30 캡이라 무영향. 기본 OFF.\"},{\"name\":\"bt_min_universe_end_time\",\"label\":\"MIN 풀세션 종료(HHMMSS)\",\"type\":\"number\",\"default\":151900,\"help\":\"full_session_enabled+min일 때 장중 윈도우 종료 시각(HHMMSS). 기본 151900(15:19).\"},{\"name\":\"bt_scope\",\"label\":\"Backtest Scope\",\"type\":\"select\",\"choices\":[\"single_stock\",\"universe\"],\"default\":\"single_stock\",\"help\":\"single_stock=MVP 빠른 평가(단일 종목), universe=느린 전체 유니버스.\"},{\"name\":\"bt_window_days\",\"label\":\"Backtest Window (days)\",\"type\":\"number\",\"default\":5,\"help\":\"단일 종목 백테스트 윈도우 거래일 수 (5일이 안전한 하한).\"},{\"name\":\"bt_timeout\",\"label\":\"Backtest Timeout (s)\",\"type\":\"number\",\"default\":300,\"help\":\"백테스트 1회 타임아웃(초). BOUNDED 스코프는 이 한참 아래에서 끝난다.\"},{\"name\":\"autopsy_enabled\",\"label\":\"Autopsy Feedback\",\"type\":\"bool\",\"default\":true,\"help\":\"켜면 매 세대 거래 통계를 분석해 다음 세대 프롬프트에 NL 피드백을 준다.\"},{\"name\":\"evolution_mode\",\"label\":\"Evolution Mode\",\"type\":\"select\",\"choices\":[\"hillclimb\",\"ga\"],\"default\":\"hillclimb\",\"help\":\"hillclimb=best 1개 점진 개선, ga=population 기반 진화(선택/교배/변이).\"},{\"name\":\"winner_objective\",\"label\":\"Winner Objective\",\"type\":\"select\",\"choices\":[\"risk_adjusted\",\"profit\",\"balanced\",\"multi\",\"uptrend\",\"multiyear\"],\"default\":\"risk_adjusted\",\"help\":\"best/winner 선택 목표. risk_adjusted=Calmar×R², profit=절대수익, balanced=둘의 블렌드(profit_weight), multi=calmar·R²·빈도·payoff 동일가중, uptrend=우상향 R²(Calmar×R²×R²), multiyear=연도교차 안정성(②, composite×stability).\"},{\"name\":\"bt_engine_mode\",\"label\":\"Engine Mode\",\"type\":\"select\",\"choices\":[\"warm\",\"cold\"],\"default\":\"warm\",\"help\":\"warm=전체유니버스 엔진 1회 prepare 후 세대마다 run(빠름), cold=세대마다 서브프로세스(폴백).\"},{\"name\":\"dispersion_prompt_enabled\",\"label\":\"분산매매 프롬프트\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매수 프롬프트의 저빈도 압력을 다종목 분산(종목 수↑·종목당 발화↓) 유도로 치환한다. 기본 OFF.\"},{\"name\":\"dispersion_enabled\",\"label\":\"분산 적합도 보상\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 게이트-실패 graded 분기에 동시보유(max_hold_count) 분산 보상항을 가산한다. 기본 OFF.\"},{\"name\":\"min_hold_symbols\",\"label\":\"분산 보상 기준(동시보유 하한)\",\"type\":\"number\",\"default\":6.0,\"help\":\"분산 보상 기준 동시보유 종목 수(보고서 6~12). 이 값 이상이면 보상항 1.0 포화.\"},{\"name\":\"require_liquidity_gate\",\"label\":\"거래대금 유동성 게이트 강제\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매수 전략 저장 전 거래대금 계열 변수+비교 조건 존재를 검증하고 없으면 재생성. 기본 OFF.\"},{\"name\":\"mdd_control_enabled\",\"label\":\"MDD 제어 강화(매도)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매도 프롬프트에 MDD 억제 최우선 블록(타이트 손절·트레일링·시간 손절)을 추가한다. 기본 OFF.\"},{\"name\":\"exit_edge_feedback_enabled\",\"label\":\"청산 효율 환류(매도)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매도 프롬프트에 edge_ratio 부검 발견(손실 MAE가 승리 대비 ~2.6배 깊음·최고평가익의 ~20%만 실현)을 환류하는 블록(손실 빠르게 끊기·트레일 익절)을 추가한다. 기본 OFF.\"},{\"name\":\"freeze_buy_on_mdd_only\",\"label\":\"MDD-only 시 매수 동결\",\"type\":\"bool\",\"default\":true,\"help\":\"best가 MDD만 부족(빈도·수익 통과)할 때 매수를 동결하고 매도(청산)만 재생성. 기본 ON.\"},{\"name\":\"segment_fine_time\",\"label\":\"시초 5분 시간대 세분(부검)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 세그먼트 부검의 시간축을 5분 시초 셀(0900-0905…0920+)로 세분한다. 비-시드 생성 전략의 시초 시간대 신호 측정용. 기본 OFF(30분 coarse).\"},{\"name\":\"encourage_time_dispersion\",\"label\":\"진입 시간 분산 유도(매수)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매수 프롬프트에 진입을 09:00~09:20에 분산하라는 소프트 가이드를 추가한다 (reject 아닌 넛지). 기본 OFF.\"},{\"name\":\"require_filter_gates\",\"label\":\"필터 범주 게이트 강제(매수)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매수 전략 저장 전 서로 다른 필터 범주를 최소 N개(아래) 비교 조건으로 결합했는지 검증하고 부족하면 재생성한다(과발화 방지). 매수 프롬프트에 시드 게이팅 가이드도 주입한다. 기본 OFF.\"},{\"name\":\"min_filter_categories\",\"label\":\"최소 필터 범주 수\",\"type\":\"number\",\"default\":5,\"help\":\"필터 범주 게이트 강제 ON일 때 매수 진입에 요구하는 최소 필터 범주 수(시드는 9). 높일수록 게이팅이 엄격해진다.\"},{\"name\":\"classification_generation_enabled\",\"label\":\"분류축 유도 생성(매수)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매수 프롬프트에 3개 분류축(시가총액 구분·등락률 구분·넓은 시간창 09:00~09:30)에서 일관된 니치를 골라 설계하라는 가이드를 추가한다(시드 5분 고착 탈피). 필터 범주 게이트와 짝(넓게 고르되 좁게 게이트). 기본 OFF.\"},{\"name\":\"sparse_positive_prompt_enabled\",\"label\":\"Sparse-positive prompt\",\"type\":\"bool\",\"default\":false,\"help\":\"Default-OFF sparse_positive_v1 generation guidance: profit > 0, MDD <= 10, trade_count 20-250, daily_avg_trades >= 0.05, payoff_ratio >= 1.05. It does not relax hard gates or selector rules.\"},{\"name\":\"few_shot_enabled\",\"label\":\"few-shot 샘플 주입\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 검증된 우수 전략(통과/인간 study) K개를 생성 프롬프트에 few-shot 코드로 주입해 변수조합·필터 게이팅 구조를 학습시킨다(변수값 복제는 금지하도록 명시). 기본 OFF.\"},{\"name\":\"few_shot_k\",\"label\":\"few-shot 샘플 수(K)\",\"type\":\"number\",\"default\":3,\"help\":\"주입할 few-shot 샘플 최대 개수(토큰/다양성 균형, 3 권장). few-shot 주입 OFF면 무영향.\"},{\"name\":\"few_shot_source\",\"label\":\"few-shot 출처\",\"type\":\"select\",\"choices\":[\"passing\",\"seed_db\"],\"default\":\"passing\",\"help\":\"passing=루프 게이트 통과 전략, seed_db=운영 strategy.db 인간 study 전략(읽기 전용). few-shot 주입 OFF면 무영향.\"},{\"name\":\"prompt_logging_enabled\",\"label\":\"프롬프트 DB 영속화\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 매 LLM 호출의 프롬프트(system 해시+user 전문+주입 피처+토큰/응답 해시)를 loop_runs.db prompts 테이블에 기록해 사후 재현을 가능하게 한다. 기본 OFF.\"},{\"name\":\"equity_points_enabled\",\"label\":\"백테 시계열 DB 영속화\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 세대마다 결과 CSV(이미 디스크에 있는 파일)의 누적수익곡선·일별손익·낙폭을 다운샘플해 loop_runs.db equity_points 테이블에 영속한다(추가 백테 없음). CSV 삭제 후에도 곡선이 보존되고 SQL 분석이 가능해진다. 기본 OFF.\"},{\"name\":\"hypothesis_tracking_enabled\",\"label\":\"가정 추적(채택/기각)\",\"type\":\"bool\",\"default\":false,\"help\":\"켜면 부검 방향성 예측(MDD↓/진입품질↑/진입완화 등)을 1급 가정으로 방출하고 다음 세대의 부모 대비 델타로 자동 채택/기각해 generations.hypotheses_json에 기록한다(추가 백테 없음). 기본 OFF.\"}]}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":0.663}},{"startedDateTime":"2026-06-04T15:02:08.872Z","time":97.963,"request":{"method":"GET","url":"https://fonts.gstatic.com/s/ibmplexmono/v20/-F63fjptAgt5VM-kVkqdyU8n1i8q1w.woff2","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"fonts.gstatic.com"},{"name":":method","value":"GET"},{"name":":path","value":"/s/ibmplexmono/v20/-F63fjptAgt5VM-kVkqdyU8n1i8q1w.woff2"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"origin","value":"http://127.0.0.1:8792"},{"name":"priority","value":"u=0"},{"name":"referer","value":"https://fonts.googleapis.com/"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"HeadlessChrome\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-fetch-dest","value":"font"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-site","value":"cross-site"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/148.0.7778.96 Safari/537.36"}],"queryString":[],"headersSize":-1,"bodySize":-1},"response":{